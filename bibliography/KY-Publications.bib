@misc{yayla_measuring_2026,
	title = {Measuring {Latent} {Documentary} {Quality} in {Scholarly} {Communication}: {An} {Indicator} {Framework} {Based} on {PDF} {Validation} and {Technical} {Debt}},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	shorttitle = {Measuring {Latent} {Documentary} {Quality} in {Scholarly} {Communication}},
	url = {https://www.researchsquare.com/article/rs-9861050/v1},
	doi = {10.21203/rs.3.rs-9861050/v1},
	abstract = {Abstract
          Indicators used to evaluate scholarly communication infrastructures—openness, indexing, citation impact, and metadata availability—assess whether research outputs are reachable and recognized, but not whether the documentary objects carrying the scholarly record are archivally stable, machine-operable, and functionally accessible. This article treats documentary quality as a latent property of scholarly communication infrastructures and develops a technical-debt-based indicator framework to measure it using observable conformance validation traces. Rather than treating validation failures as isolated technical defects, the framework translates assertion-level output into a nine-family typology that classifies each failure by the impaired documentary function and the implied locus of remediation. The framework is demonstrated on a corpus of 1,340 version-of-record Portable Document Format (PDF) files from journals indexed in the Directory of Open Access Journals and associated with library publishing programs in the United States and Canada and evaluated against three successive conformance profiles for archival preservation and semantic accessibility. Results show near-universal noncompliance across all layers, but the audit reveals that nonconformance is not methodologically homogeneous. Some failures indicate patchable metadata omissions, while others reveal upstream structural deficits that cannot be corrected after document generation. Debt families exhibit discriminant behavior across disciplinary categories, supporting the construct validity of the typology as a multi-dimensional indicator system. The framework provides a scalable measurement model for transforming machine-validation output into interpretable, documentary-quality indicators, with implications for science metrics, publication ethics, and scholarly communication infrastructure research.},
	urldate = {2026-09-12},
	publisher = {In Review},
	author = {Yayla, Kemal},
	month = sep,
	year = {2026},
	file = {Kabul Edilen Versiyon:C\:\\Users\\Dell-vestro5568\\Zotero\\storage\\EUSC9W78\\Yayla - 2026 - Measuring Latent Documentary Quality in Scholarly Communication An Indicator Framework Based on PDF.pdf:application/pdf},
}

@misc{yayla_dormancy_2026,
	title = {Dormancy as a {Contact} {Process}: {Field}-{Structured} {Pre}-{Awakening} {Citation} {Dynamics} in {Sleeping} {Beauty} {Papers}},
	shorttitle = {Dormancy as a {Contact} {Process}},
	url = {https://www.ssrn.com/abstract=6881573},
	doi = {10.2139/ssrn.6881573},
	abstract = {Sleeping Beauty (SB) papers remain largely uncited for years before awakening to sudden recognition. Existing research has focused on detecting SB behavior and characterizing the awakening event, leaving the dormancy period—the interval between publication and formal awakening—underexamined. This study shifts the analysis from detection to monitoring by asking how sparse pre-awakening citations are organized across disciplinary fields before the awakening threshold is crossed. Pre-awakening citation contacts are modeled as a recurrent event process using a Prentice–Williams–Peterson gap-time (PWP-GT) specification, in which each field-year citation contact is treated as an observed event and the waiting time to the next contact is modeled as a function of prior field-channel history. The framework is applied to 52 physics and engineering SB papers from a validated corpus with low sleeping-period intensity. The results indicate that dormancy has a measurable internal structure. Higher field entropy was associated with longer inter-contact gaps, with descriptive quartile profiles confirming a monotonic relationship between field breadth and inter-contact intermittency. HHI contributed a complementary resolution within the joint specification but did not carry a detectable standalone signal. A companion channel-dependence model indicates that field channels with a larger prior-contact share were associated with higher subsequent-contact intensity. A sleep-length-stratified diagnostic model further indicates that inter-contact gaps lengthen as the awakening boundary approaches within dormancy-duration regimes. However, this result is secondary to the distributional findings. The study contributes a monitoring framework that complements existing SB detection indicators by characterizing the internal contact ecology of the dormancy period.},
	urldate = {2026-09-12},
	publisher = {SSRN},
	author = {Yayla, Kemal},
	year = {2026},
}

@misc{yayla_hidden_2026,
	title = {Hidden {Labor} in {Team} {Science}: {Power}, {Credit}, and {Contributorship} {Structures} in {Management} of {Technology} {Journals}},
	copyright = {https://www.uspto.gov/ip-policy/copyright-policy/copyright-basics},
	shorttitle = {Hidden {Labor} in {Team} {Science}},
	url = {https://www.ssrn.com/abstract=6172764},
	doi = {10.2139/ssrn.6172764},
	abstract = {Scientific collaboration increasingly relies on large, multi-author teams, yet the internal allocation of power, labor, and intellectual leadership is difficult to discern from conventional publication metrics. Authorship order and contribution disclosures—most notably the CRediT taxonomy—provide empirically tractable indicators of team organization, but their joint use remains underdeveloped. We analyze 1,064 CRediT-enabled publications from three management-of-technology and innovation journals (Research Policy, Technological Forecasting and Social Change, Technovation; 2022–2025) and develop a framework centered on hidden labor—cases in which substantial work contributions are not reflected in byline prominence. Two supporting constructs—power–labor hierarchy coupling and a thought-leadership ratio (TLR)—characterize the organizational conditions under which hidden labor emerges. Across journals, 4–6\% of authors and 10–12\% of author–paper relationships exhibit hidden labor profiles. In Research Policy, power and labor hierarchies are positively correlated (r = 0.226, p {\textless} 0.001), whereas this pattern is not observed in the other journals. High-prestige intellectual roles are near-universally attributed (median TLR = 1.0), and 97\% of corresponding authors hold intellectual-leadership roles. These findings suggest that CRediT disclosures function as institutionally negotiated signals rather than purely descriptive records. Approximately one in nine author–paper relationships involve labor contributions that exceed what byline prominence would suggest, underscoring the need for evaluation practices to move beyond byline position alone.},
	urldate = {2026-09-12},
	publisher = {SSRN},
	author = {Yayla, Kemal},
	year = {2026},
}

@misc{yayla_many_2025,
	title = {The {Many} {Faces} of {Awakening}: {A} {Structural} {Typology} of {Sleeping} {Beauty}–{Prince} {Relations}},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	shorttitle = {The {Many} {Faces} of {Awakening}},
	url = {https://www.researchsquare.com/article/rs-8212819/v1},
	doi = {10.21203/rs.3.rs-8212819/v1},
	abstract = {Abstract
          Bibliometric studies typically identify the "Prince" of a Sleeping Beauty (SB) based on citation bursts or co-citation proximity, implicitly assuming that the awakener is a singular, structural mediator of dormant knowledge. This study challenges this assumption by decoupling bibliometric visibility from structural genealogy. Applying Main Path Analysis (MPA) with a Local Forward search to six canonical SB–Prince pairs from the hard sciences, we reconstruct the actual backbone of knowledge transmission underlying these awakening events. The analysis reveals a striking discordance between citation metrics and topological reality: the bibliometrically identified Prince frequently occupies a position inconsistent with the awakening narrative—ranging from partial mediation to complete disconnection from the SB's lineage. Based on these topological signatures, we propose a structural typology of awakening mechanisms comprising six distinct categories: Structural Founder, Catalyst, Reflexive Consolidator, Internal Evolver, Surrogate Prince, and Rival Prince. These findings demonstrate that standard metrics primarily measure who captures attention (visibility), whereas structural topology reveals who transmits intellectual heritage (genealogy). We argue, therefore, that the metaphor of the Prince requires functional redefinition to distinguish between actors who broadcast a signal and those who structurally advance the knowledge domain.},
	urldate = {2026-09-12},
	publisher = {In Review},
	author = {Yayla, Kemal},
	month = dec,
	year = {2025},
	file = {Kabul Edilen Versiyon:C\:\\Users\\Dell-vestro5568\\Zotero\\storage\\QLSQ4W59\\Yayla - 2025 - The Many Faces of Awakening A Structural Typology of Sleeping Beauty–Prince Relations.pdf:application/pdf},
}

@misc{yayla_presence_2026,
	title = {Presence {Is} {Not} {Parity}, {Visibility} {Is} {Not} {Credit}: {Gendered} {Hierarchies} in {Platform}- {Based} {Academic} {Publishing}},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	shorttitle = {Presence {Is} {Not} {Parity}, {Visibility} {Is} {Not} {Credit}},
	url = {https://www.researchsquare.com/article/rs-9152762/v1},
	doi = {10.21203/rs.3.rs-9152762/v1},
	abstract = {Abstract
          Editorial board research has consistently documented women's underrepresentation in journal leadership, but most studies measure representation through aggregate board composition or editor-in-chief counts alone. This approach conflates participation with stratification: if roles carrying different levels of authority are pooled into a single indicator, opposing distributional patterns can cancel each other out, producing a misleading appearance of parity. This study examines how editorial roles are distributed by gender across a national platform-based journal system. Analyzing 38,241 person–journal observations from 1,549 DergiPark journals, we estimate logistic and proportional-odds regression models to distinguish four role categories—executive, operational, support, and symbolic—and report average marginal effects with individual-level cluster-robust standard errors. Women are significantly less likely to hold executive editorial positions (OR = 0.583, AME = −1.63 pp) and more likely to occupy operational (OR = 1.090, AME = +1.78 pp) and support roles (OR = 1.151, AME = +0.88 pp), conditional on academic rank, disciplinary context, and institutional visibility. When these roles are aggregated into a single gatekeeping indicator, the gender coefficient becomes non-significant—not because stratification is absent, but because opposing effects cancel each other out. Role-disaggregated analysis is therefore a necessary condition for valid inference about editorial gender equity in role-differentiated settings. The findings also demonstrate that platform-standardized editorial metadata enables role-level comparisons that fragmented publisher environments cannot support.},
	urldate = {2026-09-12},
	publisher = {In Review},
	author = {Yayla, Kemal and Ceylan, Şehnaz},
	month = apr,
	year = {2026},
	file = {Kabul Edilen Versiyon:C\:\\Users\\Dell-vestro5568\\Zotero\\storage\\NA4VXC5N\\Yayla ve Ceylan - 2026 - Presence Is Not Parity, Visibility Is Not Credit Gendered Hierarchies in Platform- Based Academic P.pdf:application/pdf},
}
